-```bash
-export EGW_EXEC_REPO=$HOME/egw-exec/repo
-. "$EGW_EXEC_REPO/tools/session/common.sh"; . "$EGW_EXEC_REPO/tools/session/guest_common.sh"
-A=<the attempt directory>
