--- base/ops/seal_ops.sh
+++ ops/seal_ops.sh
@@ -1,40 +1,87 @@
 #!/bin/bash
-# Seal the operator records of one G3 battery session (WSL): a copy of the
-# steps script's state directory as it stands, the operator's launcher, waiter
-# and classification notes. Sweeps for the values of the secret variables of
-# ~/egw-tcg/.env (names only are printed). Never overwrites a package.
-# Usage: seal_ops.sh <S1|S2> <ops dir> <package dir>
+# Seal the operator records of session S3 (G3, tests 8 and 9) (WSL): a copy of
+# the steps script's state directory as it stands, the operator's launcher,
+# waiter and classification notes. Sweeps for the values of the secret
+# variables of ~/egw-tcg/.env (names only are printed, and no value is put on a
+# command line) and for private-key headers. Never overwrites a package; a
+# missing input is a stop before anything is created.
+# Usage: seal_ops.sh S3 <ops dir> <package dir> <sealed host-preparation package dir>
+#   <package dir>: .../<UTC date>/HIST_<UTC date>-g3-t8t9-s3-operator-records
+# Exit: 0 sealed; 1 a STOP after the copy began (the directory is left unsealed,
+# without SHA256SUMS: seal_ops_finish.sh, or Rui's decision); 2 refused, nothing created.
 set -u
-LABEL=${1:?} OPS=${2:?} PKG=${3:?}
-STATE=${EGW_G3_STATE:-$HOME/egw-exec/g3-battery}
+LABEL=${1:?} OPS=${2:?} PKG=${3:?} PREP=${4:?}
+STATE=${EGW_G3_STATE:-$HOME/egw-exec/g3-t8t9-s3}
+ENVF=$HOME/egw-tcg/.env
+refuse() { echo "STOP: $* - nothing was created"; exit 2; }
+[ "$LABEL" = S3 ] || refuse "the label must be S3 (the records of S1 and S2 are sealed), not $LABEL"
 [ ! -e "$PKG" ] || { echo "STOP: $PKG exists - never overwritten"; exit 2; }
+B=$(basename "$PKG"); D=$(basename "$(dirname "$PKG")")
+case $B in
+    HIST_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-g3-t8t9-s3-operator-records) ;;
+    HIST_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-g3-t8t9-s3-operator-records-attempt[0-9][0-9]) ;;   # after a half-made package, which is kept
+    *) refuse "the package must be named HIST_<UTC date>-g3-t8t9-s3-operator-records[-attemptNN], not $B" ;;
+esac
+case $B in "HIST_$D-g3-t8t9-s3-operator-records"*) ;; *) refuse "$B is not under a directory named after its own date (it is under $D)" ;; esac
+[ -d "$STATE" ] && [ -n "$(ls -A "$STATE")" ] || refuse "the state directory $STATE is missing or empty"
+for f in g3_go.sh g3_wait.sh seal_ops.sh; do [ -f "$OPS/$f" ] || refuse "$OPS/$f is missing"; done
+cmp -s "$0" "$OPS/seal_ops.sh" || refuse "the sealing script being run is not $OPS/seal_ops.sh"
+case $(basename "$PREP") in HIST_*-g3-t8t9-host-preparation*) ;; *) refuse "$PREP is not a host-preparation package of S3" ;; esac
+[ -f "$PREP/SHA256SUMS" ] && [ -f "$PREP/g3_battery.sh" ] || refuse "$PREP is not a sealed host-preparation package (no SHA256SUMS or no g3_battery.sh)"
+[ -r "$ENVF" ] || refuse "$ENVF could not be read: the secret sweep cannot be made"
+NSEC=$(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$ENVF" | cut -d= -f1 | grep -cE 'PASS|SECRET|TOKEN|KEY|CREDENTIAL')
+[ "$NSEC" -gt 0 ] || refuse "$ENVF names no secret variable: the sweep would be empty"
+
 mkdir -p "$PKG/state" "$PKG/operator" || exit 2
 cp -r "$STATE"/. "$PKG/state/" || exit 1
 rm -f "$PKG/state/turn.lock"
 cp "$OPS"/g3_go.sh "$OPS"/g3_wait.sh "$OPS"/seal_ops.sh "$PKG/operator/" || exit 1
-cp -r "$OPS/notes" "$PKG/operator/classification-notes" || exit 1
-hits=0
+if [ -d "$OPS/notes" ]; then cp -r "$OPS/notes" "$PKG/operator/classification-notes" || exit 1; fi
+
+# Secret sweep: the values of the secret-named variables of the real .env. A
+# value reaches grep through a file descriptor, never through its command line.
+hits=0 swept=0
 while IFS='=' read -r name value; do
     case "$name" in *PASS*|*SECRET*|*TOKEN*|*KEY*|*CREDENTIAL*) ;; *) continue ;; esac
     value=${value%\"}; value=${value#\"}; value=${value%\'}; value=${value#\'}
     [ "${#value}" -ge 4 ] || continue
-    n=$(grep -rlF -- "$value" "$PKG" 2> /dev/null | wc -l)
+    n=$(grep -rlF -f <(printf '%s\n' "$value") -- "$PKG" 2> /dev/null | wc -l)
     echo "secret sweep: $name -> $n file(s)"
-    hits=$((hits + n))
-done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$HOME/egw-tcg/.env")
-pem=$(grep -rl -- '-----BEGIN .*PRIVATE KEY-----' "$PKG" 2> /dev/null | wc -l)
-echo "secret sweep: PEM private keys -> $pem file(s)"
+    hits=$((hits + n)); swept=$((swept + 1))
+done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$ENVF")
+[ "$swept" -gt 0 ] || { echo "STOP: no secret-named variable was read from $ENVF: the sweep would be empty - NOT sealed"; exit 1; }
+# S3: the header pattern no longer matches its own text in the copy of this
+# script inside the package (the false alarm that stopped the sealing of S1 and
+# of S2): the bracket after BEGIN is not a capital letter or a space, and the
+# quotes split the tail.
+PAT='-----BEGIN [A-Z ]*PRIVATE KEY''-----'
+pem=$(grep -rlE -- "$PAT" "$PKG" 2> /dev/null | wc -l)
+echo "secret sweep: PEM private-key headers -> $pem file(s)"
 [ "$hits" -eq 0 ] && [ "$pem" -eq 0 ] || { echo "STOP: a secret value is in the package - NOT sealed"; exit 1; }
+
+same() {   # same <file as opened> <file of the preparation package>: one sentence
+    local a b
+    [ -f "$1" ] || { echo "not recorded in the state directory"; return; }
+    a=$(sha256sum "$1" | cut -d' ' -f1); b=$(sha256sum "$2" 2> /dev/null | cut -d' ' -f1)
+    if [ "$a" = "$b" ]; then echo "sha256 $a, equal to the preparation package's"
+    else echo "sha256 $a, DIFFERENT from the preparation package's (${b:-unreadable})"; fi
+}
 {
-echo "# G3 qualifying battery, session $LABEL: operator records"
+echo "# G3, session S3 (tests 8 and 9): operator records (sealed $(date -u +%FT%TZ))"
 echo
 echo "state/: the steps script's state directory as it stood when this package was sealed (session and row state"
 echo "files, one console per invocation, the frozen drivers' consoles, the environment copy record, the script and"
 echo "manifest as opened). operator/: the operator's launcher and waiter (read-only helpers that start one"
 echo "subcommand detached and wait for it), this sealing script, and the classification notes given to 'classify'"
-echo "(one reason and one next-action file per row). The row, session, preflight and gate packages are beside this"
-echo "one under the same date; the steps script, the row files and their verification are in"
-echo "HIST_2026-10-02-g3-battery-host-preparation."
+if [ -d "$PKG/operator/classification-notes" ]; then echo "(one reason and one next-action file per classified row)."
+else echo "(none here: there was no notes directory when this package was sealed)."; fi
+echo "The session, preflight, gate and row packages are under output_test/runs/, each under its own UTC date;"
+echo "state/session-S3.env and state/row-*.env name them. Nothing here is a G3 result."
+echo
+echo "The steps script, the row files and their verification are in $(basename "$PREP")"
+echo "(its SHA256SUMS: sha256 $(sha256sum "$PREP/SHA256SUMS" | cut -d' ' -f1))."
+echo "- steps script as opened (state/S3-g3_battery.sh): $(same "$PKG/state/S3-g3_battery.sh" "$PREP/g3_battery.sh")"
+echo "- manifest as opened (state/S3-rows.manifest.json): $(same "$PKG/state/S3-rows.manifest.json" "$PREP/rows/rows.manifest.json")"
 } > "$PKG/README.md"
 ( cd "$PKG" && find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS )
 echo "sealed $(wc -l < "$PKG/SHA256SUMS") files; seal $(sha256sum "$PKG/SHA256SUMS" | cut -c1-12)"
