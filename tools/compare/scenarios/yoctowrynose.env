# shellcheck shell=bash
# Scenario `yoctowrynose`: the yoctoWrynose image (Yocto Project 6.0.3 "Wrynose", MACHINE genericarm64),
# built on 2026-10-20 as a portable UEFI disk. It is booted from the sealed package ~/images/yoctoWrynose
# (never written by these tools) through the edk2 UEFI firmware shipped in that package: firmware ->
# systemd-boot -> kernel + initramfs from the disk's EFI system partition. There is no -kernel/-append;
# the kernel command line is the one of the disk's systemd-boot entry. Sourced by lib.sh::scenario_load.
SCENARIO=yoctowrynose
DISTRO_LABEL="Poky 6.0.3 (wrynose) egw-gateway-image genericarm64, rootfs 20261020145425"
GUEST_HOSTNAME=yoctowrynose
BASE_KIND=uefi-disk
WRYNOSE_PACKAGE=${EGW_WRYNOSE_PACKAGE:-$HOME/images/yoctoWrynose}
BASE_ROOTFS_SRC=$WRYNOSE_PACKAGE/yoctoWrynose.qcow2
BASE_FW_CODE_SRC=$WRYNOSE_PACKAGE/firmware/edk2-aarch64-code.fd
BASE_FW_VARS_SRC=$WRYNOSE_PACKAGE/firmware/edk2-arm-vars.fd
BASE_KERNEL_SRC=
BASE_INITRD_SRC=
# The base copy is the package's qcow2 (GPT: EFI system partition + ext4 root); the work disk is a qcow2 overlay.
ROOT_FORMAT=qcow2
# Not used for this kind: the command line comes from the systemd-boot entry on the disk
# ('root=PARTUUID=... rootwait rootfstype=ext4 console=ttyAMA0,115200').
KERNEL_APPEND=
FIRSTBOOT_APPEND=
BASE_IMAGE_URL=
BASE_IMAGE_SHA512=
BASE_IMAGE_FILE=
# The image authorises only its own test key (not egw_campaign); the other scenarios keep theirs.
COMPARE_SSH_KEY=${EGW_WRYNOSE_SSH_KEY:-$HOME/.ssh/egw_wrynose_share}
# Differences from the other scenarios that no setting removes (recorded in the manifest).
KNOWN_DIFFERENCES="linux-yocto 6.18.39 genericarm64 kernel with initramfs (all modules)|UEFI boot: edk2 firmware, systemd-boot, initramfs (not counted in the other scenarios)|no mem=8192M/swiotlb=0 on the kernel command line|BusyBox 1.37.0 userland, no package manager|docker-moby 29.3.0, compose 5.1.0, containerd 2.2.2, runc 1.5.0-rc.1|systemd 259, OpenSSH 10.3p1 (ECDSA host key only, socket-activated)|docker.service drop-in WantsMountsFor (Scarthgap: RequiresMountsFor)|root disk: GPT, 88 MiB EFI system partition + 3.4 GiB ext4|not part of the measured series a02"
