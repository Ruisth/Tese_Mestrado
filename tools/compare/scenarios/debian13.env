# shellcheck shell=bash
# Scenario `debian13`: Debian 13 (trixie) genericcloud arm64, a dated official release (never
# `latest`), provisioned once by cloud-init for the same application stack, then frozen as an
# immutable prepared base. Sourced by tools/compare/lib.sh::scenario_load.
SCENARIO=debian13
DISTRO_LABEL="Debian 13.8 (trixie) genericcloud arm64 20261017-2634"
GUEST_HOSTNAME=egw-qemu-debian13
BASE_KIND=debian-cloud
BASE_IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/20261017-2634/debian-13-genericcloud-arm64-20261017-2634.qcow2
BASE_IMAGE_FILE=debian-13-genericcloud-arm64-20261017-2634.qcow2
# Published in https://cloud.debian.org/images/cloud/trixie/20261017-2634/SHA512SUMS (read 2026-10-18).
BASE_IMAGE_SHA512=0199ea72dd82e84264fda5068c5756412c778f395fca6748a186f2d0a34f524fe406e87339bda0b7f71aa9bab066b9850cde44cd1650116f389dc3f786cb232b
BASE_ROOTFS_SRC=
BASE_KERNEL_SRC=
BASE_INITRD_SRC=
# The prepared base is a qcow2; the work disk is a qcow2 overlay on it.
ROOT_FORMAT=qcow2
# Direct kernel boot with Debian's own kernel and initrd extracted from the image (its native path
# is UEFI + GRUB; recorded as a difference). @ROOT_UUID@ is filled from the extracted root partition.
KERNEL_APPEND="root=UUID=@ROOT_UUID@ rw mem=8192M console=ttyAMA0 swiotlb=0"
# First boot only: cloud-init NoCloud seed served from the host loopback (10.0.2.2 under slirp).
FIRSTBOOT_APPEND="ds=nocloud;s=http://10.0.2.2:@SEED_PORT@/"
# Differences from the other scenario that no setting removes (recorded in the manifest).
KNOWN_DIFFERENCES="Debian linux-image 6.12.113 cloud flavour|GNU userland, dash, apt (apt timers masked after first boot)|docker.io 26.1.5, docker-compose 2.26.1 and containerd/runc from Debian|iptables nft backend|cloud-init present, disabled after the first boot|tzdata present (Etc/UTC)|native boot path UEFI+GRUB, booted here by direct kernel load|root disk: GPT image of 3.0 GiB grown by cloud-initramfs-growroot at first boot"
