# shellcheck shell=bash
# Scenario `yocto`: the project's own image, exactly the artefacts the pilot sessions booted
# (deploy directory of the integrated profile). Sourced by tools/compare/lib.sh::scenario_load.
SCENARIO=yocto
DISTRO_LABEL="Poky 5.0.19 (scarthgap) egw-gateway-image qemuarm64, rootfs 20260918120819"
GUEST_HOSTNAME=egw-qemu-integrated
BASE_KIND=yocto-deploy
# The deploy directory of the integrated build (never written by these tools).
YOCTO_DEPLOY=${EGW_YOCTO_DEPLOY:-$HOME/yocto/egw/src/yocto/build-integrated/tmp/deploy/images/qemuarm64}
BASE_ROOTFS_SRC=$YOCTO_DEPLOY/egw-gateway-image-qemuarm64.rootfs-20260918120819.ext4
BASE_KERNEL_SRC=$YOCTO_DEPLOY/Image
BASE_INITRD_SRC=
# The base copy is a raw ext4 (no partition table); the work disk is a qcow2 overlay on it.
ROOT_FORMAT=raw
# The kernel command line runqemu produced for the pilot (recorded 2026-10-09), unchanged.
KERNEL_APPEND="root=/dev/vda rw mem=8192M ip=dhcp console=ttyAMA0 console=hvc0 swiotlb=0"
FIRSTBOOT_APPEND=
BASE_IMAGE_URL=
BASE_IMAGE_SHA512=
BASE_IMAGE_FILE=
# Differences from the other scenario that no setting removes (recorded in the manifest).
KNOWN_DIFFERENCES="linux-yocto 6.6.142 kernel|BusyBox 1.36.1 userland, no package manager|docker-moby 25.0.9, compose v2.26.0, containerd 2.0.10, runc 1.1.14|iptables legacy backend|avahi-daemon present|no tzdata (UTC)|root disk: unpartitioned ext4 of 2,621,364,224 bytes|base copy = the deploy ext4 as it is today (post-pilot state), not a pristine rebuild"
