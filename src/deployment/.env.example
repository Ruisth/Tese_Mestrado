# .env.example — template for src/deployment/.env
#
# Copy to .env, fill in the CHANGE_ME values, never commit .env (plan §9.2:
# secrets, private certificates and passwords stay out of version control).
#
# This single file serves two consumers:
#   1. docker compose interpolation + controller env_file:
#        docker compose --env-file .env --env-file images.lock.env up -d
#      (passing --env-file disables automatic .env loading, so BOTH files
#      must always be given explicitly);
#   2. host-run tooling (simulator, experiments harness) that sources it.
#
# NOTE: inside the compose network the controller service OVERRIDES the
# topology-dependent variables (EGW_MQTT_HOST, EGW_MQTT_CA_CERT,
# EGW_DITTO_BASE_URL, EGW_SCHEMA_DIR, EGW_EVENT_LOG_DIR, credentials) — see
# compose.yaml. The EGW_* values below matter for host-run processes and as
# the documented defaults (CONTRACTS.md §6).

# ---------------------------------------------------------------------------
# Gateway identity (CONTRACTS.md §6)
# ---------------------------------------------------------------------------
EGW_ID=egw-01

# ---------------------------------------------------------------------------
# MQTT (CONTRACTS.md §1/§6)
# ---------------------------------------------------------------------------
EGW_MQTT_HOST=localhost
EGW_MQTT_PORT=8883
# Controller broker credentials. The password MUST equal
# MOSQUITTO_CONTROLLER_PASSWORD below (compose wires that variable in;
# host-run controllers read these two).
EGW_MQTT_USERNAME=egw-controller
EGW_MQTT_PASSWORD=CHANGE_ME_controller_password
# TLS is mandatory except for localhost-only dev (--no-tls profile, never in
# benchmarks).
EGW_MQTT_TLS=true
# CA certificate produced by scripts/generate-dev-tls.sh (host-side path;
# in-container the controller uses /certs/ca.crt via compose).
EGW_MQTT_CA_CERT=./mosquitto/config/certs/ca.crt
EGW_MQTT_TOPIC_FILTER=c2dt/+/+/telemetry

# ---------------------------------------------------------------------------
# Ditto (CONTRACTS.md §4/§6)
# ---------------------------------------------------------------------------
# Loopback URL for host-run tools; inside compose the controller is
# overridden to the same hostname:port on the service network.
EGW_DITTO_BASE_URL=http://127.0.0.1:8080
# "pre" = pre-authentication header (x-ditto-pre-authenticated); "basic"
# would use EGW_DITTO_USERNAME/EGW_DITTO_PASSWORD instead.
EGW_DITTO_AUTH_MODE=pre
EGW_DITTO_PREAUTH_SUBJECT=pre:egw-controller
# Only used when EGW_DITTO_AUTH_MODE=basic; leave empty for "pre".
EGW_DITTO_USERNAME=
EGW_DITTO_PASSWORD=

# ---------------------------------------------------------------------------
# Controller runtime (CONTRACTS.md §5/§6)
# ---------------------------------------------------------------------------
# Host-side defaults; the container overrides schema and event-log paths.
EGW_SCHEMA_DIR=src/schemas
EGW_EVENT_LOG_DIR=./data/events
EGW_HTTP_PORT=8000
EGW_RETRY_MAX=3
EGW_RETRY_BACKOFF_MS=200

# ---------------------------------------------------------------------------
# Deployment-only settings (not part of CONTRACTS.md §6)
# ---------------------------------------------------------------------------
# Mosquitto dev users created by scripts/generate-dev-auth.sh. The script
# reads these variables (or takes the passwords as positional arguments) and
# never prints them.
MOSQUITTO_SIMULATOR_PASSWORD=CHANGE_ME_simulator_password
MOSQUITTO_CONTROLLER_PASSWORD=CHANGE_ME_controller_password

# Password for the Ditto gateway devops/status endpoints (user "devops").
# Upstream ships a commented-out default of "foobar"; a real value is
# mandatory here.
DITTO_DEVOPS_PASSWORD=CHANGE_ME_devops_password

# Optional extra TLS SAN entry (public hostname or IP of the ARM64 VM) used
# by scripts/generate-dev-tls.sh so the external simulator can verify the
# broker certificate. Leave empty for local-only setups.
EGW_HOST=

# Container timezone. UTC keeps container logs aligned with the RFC 3339 UTC
# event timestamps (upstream Ditto compose uses Europe/Berlin).
TZ=UTC
