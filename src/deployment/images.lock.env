# images.lock.env — OCI image pins for the EGW ARM64 stack (plan §9.2).
#
# Format (one per pulled image; consumed by compose.yaml interpolation and by
# scripts/resolve-image-lock.sh):
#
#   IMAGE_<NAME>=<repository>:<tag>@sha256:<digest>
#
# The digest is the MULTI-ARCH MANIFEST-LIST digest (what `docker manifest
# inspect <repo>:<tag>` describes and what pull-by-digest resolves); Docker
# then selects the linux/arm64 child image from that list. Per-arch child
# digests are recorded in comments for cross-checking.
#
# Verification record: all digests and the presence of a linux/arm64 (v8)
# entry were read from the Docker Hub API
# (https://hub.docker.com/v2/repositories/<ns>/<repo>/tags/<tag>) on
# 2026-08-07. They MUST be re-verified on the ARM64 VM before the first
# deploy with:
#
#   ./scripts/resolve-image-lock.sh          # verify (fails on mismatch)
#   docker manifest inspect <repo>:<tag>     # manual fallback per image
#
# If an entry ever needs re-pinning, run scripts/resolve-image-lock.sh
# --update and record the change in the project LOG.
#
# The controller image is NOT listed here: it is built locally from
# src/Dockerfile (never pulled), reproducible via the pinned base image in
# the Dockerfile plus the git commit recorded in each run manifest.

# eclipse-mosquitto 2.0.22 — latest 2.0.x patch on Docker Hub as of
# 2026-08-07 (tag pushed 2026-06-22). linux/arm64/v8 present.
IMAGE_MOSQUITTO=docker.io/library/eclipse-mosquitto:2.0.22@sha256:212f89e1eaeb2c322d6441b64396e3346026674db8fa9c27beac293405c32b3c

# mongo 7.0.39 — latest 7.0.x patch on Docker Hub as of 2026-08-07 (tag
# pushed 2026-08-04). linux/arm64/v8 present.
IMAGE_MONGODB=docker.io/library/mongo:7.0.39@sha256:35a5926f71f8b6cb19206bee928c5a85f241a8be99f20c81abe35ae78a73415d

# eclipse/ditto-* 3.9.4 — tags pushed 2026-07-16. linux/arm64 present in all
# three manifest lists (plus amd64 and two attestation entries).
# arm64 child digests recorded from the same Docker Hub API responses:
#   policies arm64: sha256:2750b93612e6ad4b2311c339cc446ad42d698b61e88ab46ee0b78f20e9009fcb
#   things   arm64: sha256:c978c653ae9faf09cfa43a37630819fed88ebeaf0820ac43fc4d103b14d2c2bc
#   gateway  arm64: sha256:c03e51770a8ca9f6a4bc9bc939f5fb48d83cd9479fc320a81e76898e0e200a02
IMAGE_DITTO_POLICIES=docker.io/eclipse/ditto-policies:3.9.4@sha256:652f75b9accfc1da8cbc228bcede0f7778e732b9625225dafad4a2930903d4bb
IMAGE_DITTO_THINGS=docker.io/eclipse/ditto-things:3.9.4@sha256:a1cc8a12d167ae5a22a31c9163913736ca14dcef4b544e6270265965089247b0
IMAGE_DITTO_GATEWAY=docker.io/eclipse/ditto-gateway:3.9.4@sha256:fc9102b5ed18e5ee402fd5a1a023c5d93c215dce6fd3f24d7efb4a9f6e08682b
